{
  "version": 2,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win64-debug",
      "displayName": "Windows x64 Debug (MinGW-w64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake"
      }
    },
    {
      "name": "win64-release",
      "displayName": "Windows x64 Release (MinGW-w64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-w64-x86_64.cmake"
      }
    },
    {
      "name": "win32-debug",
      "displayName": "Windows x86 Debug (MinGW-w64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win32-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-w64-i686.cmake"
      }
    },
    {
      "name": "win32-release",
      "displayName": "Windows x86 Release (MinGW-w64)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/win32-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/mingw-w64-i686.cmake"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "win64-debug",
      "configurePreset": "win64-debug"
    },
    {
      "name": "win64-release",
      "configurePreset": "win64-release"
    },
    {
      "name": "win32-debug",
      "configurePreset": "win32-debug"
    },
    {
      "name": "win32-release",
      "configurePreset": "win32-release"
    }
  ]
}
